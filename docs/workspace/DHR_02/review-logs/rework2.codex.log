+function Read-RelayJson([string]$Path) {
+  $value = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json -AsHashtable -DateKind String -ErrorAction Stop
+  if ($value -isnot [hashtable]) { throw 'json-not-object' }
+  $value
+}
 

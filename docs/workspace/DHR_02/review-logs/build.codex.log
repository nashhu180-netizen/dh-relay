diff --git a/tools/relay/tests/fixtures/runner/adapter/launch-ok.json b/tools/relay/tests/fixtures/runner/adapter/launch-ok.json
new file mode 100644
index 0000000000000000000000000000000000000000..95590188287c87ab828d66d02eaab84ce1f0f8f6
--- /dev/null

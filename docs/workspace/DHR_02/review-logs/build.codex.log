diff --git a/tools/relay/tests/fixtures/runner/checkpoints/ckpt-A1-answer-key.json b/tools/relay/tests/fixtures/runner/checkpoints/ckpt-A1-answer-key.json
new file mode 100644
index 0000000000000000000000000000000000000000..cb0f94ed96458099c07bf4b0f28ffc8af071719e
--- /dev/null

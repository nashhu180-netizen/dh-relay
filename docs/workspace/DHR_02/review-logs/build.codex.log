diff --git a/tools/relay/tests/fixtures/runner/adapter/probe-errors-3.json b/tools/relay/tests/fixtures/runner/adapter/probe-errors-3.json
new file mode 100644
index 0000000000000000000000000000000000000000..cff7acc72ebe4587b026e350e4ef1f770f9c032f
--- /dev/null

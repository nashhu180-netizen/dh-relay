index 0000000000000000000000000000000000000000..969a98f450c641ed490a11cf45ecab1b464e00f4
--- /dev/null
+++ b/tools/relay/tests/fixtures/runner/plans/plan-v1-single-A.json
@@ -0,0 +1,11 @@
+{
+  "schema_version": "relay/v1",
+  "plan_version": 1,
+  "plan_hash": "ee4754d77ab53bd60aad19ff8078390d8f5478f8692ee2ad34fd5f895591d72e",

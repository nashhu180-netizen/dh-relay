+  $hits=@(Select-String -Path (Join-Path $PSScriptRoot '../runner/relay-replay.ps1') -Pattern '\.resume\b|\.suspend\b|adapter\.resume|adapter\.suspend|question|options|answer');Assert-True ($hits.Count-eq0) 'replay source has no answer or resume path'
+}finally{if(Test-Path $root){Remove-Item -LiteralPath $root -Recurse -Force}}

 @{
   SchemaVersion = 'relay/v1'
   SessionTailMaxBytes = 65536
-  ProbeMaxConsecutiveFailures = 3
-  StallThresholdSeconds = 1800
-}
+  ProbeMaxConsecutiveFailures = 3
+  StallThresholdSeconds = 1800
+  LaunchDeadlineSeconds = 120

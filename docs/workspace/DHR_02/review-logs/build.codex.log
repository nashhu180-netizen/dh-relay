diff --git a/tools/relay/tests/fixtures/runner/plans/plan-v2-bad-orchestrator.json b/tools/relay/tests/fixtures/runner/plans/plan-v2-bad-orchestrator.json
new file mode 100644
index 0000000000000000000000000000000000000000..b51e4e00fbb8064f8e3c4c7cab2556acfd270d7b
--- /dev/null
+++ b/tools/relay/tests/fixtures/runner/plans/plan-v2-bad-orchestrator.json
@@ -0,0 +1,12 @@
+{
+  "schema_version": "relay/v1",
+  "plan_version": 2,

diff --git a/tools/relay/tests/fixtures/runner/plans/plan-v1-wrong-run.json b/tools/relay/tests/fixtures/runner/plans/plan-v1-wrong-run.json
new file mode 100644
index 0000000000000000000000000000000000000000..5b3df48889f80c4262fd6a9d2266590d2979f8e3
--- /dev/null
+++ b/tools/relay/tests/fixtures/runner/plans/plan-v1-wrong-run.json

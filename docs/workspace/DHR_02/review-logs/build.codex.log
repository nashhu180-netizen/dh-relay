@@ -0,0 +1,5 @@
+{"launches":[
+  {"launch_result":"ok","probes":["running","running"],"on_stop":"exited","host_observations":[]},
+  {"launch_result":"ok","probes":["running","running"],"on_stop":"exited","host_observations":[]},
+  {"launch_result":"ok","probes":["running","running"],"on_stop":"exited","host_observations":[]}
+]}
diff --git a/tools/relay/tests/fixtures/runner/adapter/decision.json b/tools/relay/tests/fixtures/runner/adapter/decision.json
new file mode 100644
index 0000000000000000000000000000000000000000..3cb5c86a88c87c27739089bff4221b1298e34640
--- /dev/null
+++ b/tools/relay/tests/fixtures/runner/adapter/decision.json
@@ -0,0 +1,5 @@

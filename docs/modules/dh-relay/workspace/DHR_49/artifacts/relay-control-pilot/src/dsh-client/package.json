{
  "name": "@personal/dsh-relay-client",
  "version": "0.0.0-pilot.1",
  "description": "Read-only Relay list/detail panel for the DSH P4 Pilot",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./model": "./src/model.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "src/model.mjs",
    "src/client/panel.cjs",
    "scripts/build.mjs",
    "scripts/verify-build.mjs",
    "cordis.patch.yml",
    "disable.patch.yml",
    "enable.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "verify-build": "node scripts/verify-build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}

function Assert-Subsequence($actual,$expected,[string]$name){$at=0;foreach($item in $actual){if($at-lt$expected.Count-and$item-ceq$expected[$at]){$at++}};Assert-True ($at-eq$expected.Count) $name}
function Copy-State($s){$s|ConvertTo-Json -Depth 20|ConvertFrom-Json -AsHashtable -DateKind String}

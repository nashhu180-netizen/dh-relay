   # Illegal observation returns the prefixed transition-contract reason built on the same line.
-  @{ File = 'relay-runner.ps1'; Line = '$reason="transition-rejected:$($move.reason)";[void](Add-RelayEvent $Run ''observation'' $identity $reason @{terminal_state=$node.terminal_state});Set-RelayNodePaused $Run $NodeId ''illegal-terminal-transition'';return @{ok=$false;reason=$reason}' }
+  @{ File = 'relay-runner.ps1'; Line = '$reason="transition-rejected:$($move.reason)";[void](Add-RelayEvent $Run ''observation'' $identity $reason @{terminal_state=$node.terminal_state});if(-not $node.final_committed){Set-RelayNodePaused $Run $NodeId ''illegal-terminal-transition''};return @{ok=$false;reason=$reason}' }
   # Result identity rejection forwards the DHR_01 identity verdict reason.
   @{ File = 'relay-runner.ps1'; Line = '[void](Add-RelayEvent $Run $kind (Get-RelayValueIdentity $value) $verdict.reason);return @{ok=$false;verdict=$verdict.verdict;reason=$verdict.reason}' }
   # Result transition rejection forwards the DHR_01 matrix reason.
@@ -82,7 +87,9 @@

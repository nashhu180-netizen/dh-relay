      $pair=Test-RelayTransitionPair $verdict.terminal_move $verdict.result_move
      if(-not $pair.ok){[void](Add-RelayEvent $Run 'observation' $identity $pair.reason @{terminal_state=$node.terminal_state});Set-RelayNodePaused $Run $NodeId 'probe-lost';return @{ok=$false;reason=$pair.reason}}
      $node.terminal_state=$verdict.terminal_move.to;$node.result_status=$verdict.result_move.to
